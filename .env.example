# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Groq model (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: comma-separated guild IDs to scope slash commands during development
# Leave empty for global commands.
DEV_GUILD_IDS=

# Optional: category ID (int) under which private roleplay channels will be created.
# Leave empty to create them at the top level of the guild.
RP_CATEGORY_ID=

# Optional: per-call Groq timeout (seconds). Defaults to 60.
GROQ_TIMEOUT_SECONDS=60
